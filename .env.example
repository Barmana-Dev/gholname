NODE_ENV=development
# فقط پشت یک reverse proxy مورد اعتماد true شود؛ در اجرای مستقیم false بماند.
TRUST_PROXY=false
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=regbroker
DB_POOL_SIZE=10
DB_QUEUE_LIMIT=1000
DB_CONNECT_TIMEOUT_MS=10000
JWT_SECRET=replace-with-at-least-32-random-characters
FIELD_ENCRYPTION_KEY=replace-with-64-hex-characters
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
PAYMENT_MODE=disabled
OFFICIAL_LEGAL_ACCOUNT_NAME=
OFFICIAL_LEGAL_ACCOUNT_NUMBER=
OFFICIAL_LEGAL_IBAN=
REGISTRY_API_MODE=mock-disabled
REGISTRY_TEST_API_BASE_URL=
REGISTRY_TEST_API_TOKEN=
REGISTRY_PRODUCTION_API_BASE_URL=
REGISTRY_PRODUCTION_API_TOKEN=
BACKUP_DIR=backups
BACKUP_ENCRYPTION_PASSWORD=replace-with-a-strong-backup-password
MONITOR_DISK_PATH=.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
REQUIRE_MOBILE_OTP=false
# نشست امن (کوکی HttpOnly + CSRF)
SESSION_TTL_HOURS=8
# آپلود: در production مقدار clamav الزامی است (clamd باید در دسترس باشد)
UPLOAD_SCAN_MODE=off
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
UPLOAD_DAILY_FILE_LIMIT=50
UPLOAD_DAILY_MB_LIMIT=200
# CDR: بازسازی فایل‌ها (تصویر با sharp، PDF با Ghostscript، KML با whitelist). در production الزامی است.
CDR_MODE=off
GS_BIN=gs
CDR_PDF_DPI=150
CDR_MAX_PAGES=100
CDR_TIMEOUT_MS=60000
UPLOAD_ORPHAN_MIN_AGE_MINUTES=60
# ایجاد اولین مدیر در production (بدون seed.sql)
# BOOTSTRAP_ADMIN_MOBILE=09xxxxxxxxx
# BOOTSTRAP_ADMIN_NAME=
# مدیران باید MFA فعال کنند (پیش‌فرض: production=true)
# REQUIRE_ADMIN_MFA=true
# محدودیت درخواست مشترک بین چند process/replica؛ در production الزامی است: database
RATE_LIMIT_STORE=memory
# TLS به MySQL؛ برای DB_HOST غیرمحلی در production الزامی است
DB_SSL=false
# DB_SSL_CA=/path/to/ca.pem
# نقطهٔ مستقل برای anchor زنجیرهٔ audit (HTTPS) و توکن endpoint جزئیات سلامت
# AUDIT_ANCHOR_URL=
# AUDIT_ANCHOR_TOKEN=
# HEALTH_DETAILS_TOKEN=at-least-24-random-characters
